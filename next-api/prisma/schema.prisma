}

model workorder {
  WOID            String          @id
  WO_Number       Int?            @db.Int
  CaseID          String?
  WorkOrderNumber String?         @db.VarChar(100) //THIS IS SAME AS WOID?
  WorkOrderType   String?         @db.VarChar(50)
  Priority        String?         @db.VarChar(50)
  SystemStatus    WorkOrderStatus @default(OPEN_UNSCHEDULED)
  SubStatus       String?         @db.VarChar(50)
  PreferredDay    DateTime?       @db.Date
  PreferredTime   DateTime?       @db.Time(0)
  ShipmentCountry String?         @db.VarChar(50)
  ShipmentState   String?         @db.VarChar(50)
  CreatedOn       DateTime?       @default(now()) @db.DateTime(0)
  ChangedDate     DateTime?       @default(now()) @db.DateTime(0)
  OwnerID         Int?
  owner           User?           @relation("UserWorkOrders", fields: [OwnerID], references: [IDUser], onDelete: Restrict)

  SLAJeopardy                 String?          @db.VarChar(50)
  DueDateCustomer             DateTime?        @db.DateTime(0)
  CoverageWindow              String?          @db.VarChar(100)
  Response                    String?          @db.VarChar(100)
  // OTCCode                     String?          @db.VarChar(50)
  RequestedDateTimeCustomer   DateTime?        @db.DateTime(0)
  GuaranteedFixTimeCustomer   DateTime?        @db.DateTime(0)
  EarlyStartDateTimeCustomer  DateTime?        @db.DateTime(0)
  LatestStartDateTimeCustomer DateTime?        @db.DateTime(0)
  SLAReschedule               String?          @db.VarChar(50)
  ActiveScheduleDate          DateTime?        @db.DateTime(0)
  SLAErrorDescription         String?          @db.Text
  CasePriorityIndex           Int?
  PartnerStatus               String?          @db.VarChar(50)
  WorkOrderDescription        String?          @db.Text
  PartnerNotes                String?          @db.Text
  IncomingChannel             String?          @db.VarChar(50)
  // Link to chosen warranty Service Catalog (1 WO -> 1 servicecatalog)
  ServiceCatalogID            Int?
  serviceCatalog              servicecatalog?  @relation(fields: [ServiceCatalogID], references: [ServiceCatalogID], onDelete: SetNull)
  materialorder               materialorder[]
  caseinformation             caseinformation? @relation(fields: [CaseID], references: [CaseID], onDelete: Restrict, map: "workorder_ibfk_1")
  bookings                    Bookings[]       @relation("WorkOrderBookingsCase")

  // TODO : FIND WTF IS DIS ABOT
  ServiceTypeId Int?
  ServiceType   ServiceType? @relation(fields: [ServiceTypeId], references: [ServiceTypeId], onDelete: Restrict)
  DelayCode     DelayCode?
  NMUId         Int?
  NMU           NMU?         @relation(fields: [NMUId], references: [NMUId])
  VersionNMU    String?
  NMUItemId     Int?
  NMUItem       NMUItem?     @relation(fields: [NMUItemId], references: [id])
  CEAnalysis    String?      @db.Text
  DefectDesc    String?      @db.Text
  RepairAction  String?      @db.Text

  IsCancel     Boolean @default(false)
  CancelReason String? @db.Text

  @@unique([ServiceCatalogID])
  @@index([CaseID], map: "CaseID")
  @@index([OwnerID])
}

