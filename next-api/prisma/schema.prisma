}

model Bookings {
  BookingId Int @id @default(autoincrement())

  BookingStatusId Int?
  BookingStatus   BookingStatus? @relation(fields: [BookingStatusId], references: [BookingStatusId])
  WOID            String

  // SLA  
  ScheduleJeopardy     Boolean?
  ScheduleJeopardyTime DateTime?

  DoNotDisturb     Boolean?
  CeScheduleChange Boolean?
  CreatedAt        DateTime @default(now()) @db.DateTime(0)
  CreatedBy        Int

  // TotalDuration
  TotalBillableDurationInMinutes   Int?
  TotalInProgressDurationInMinutes Int?
  TotalBreakDurationInMinutes      Int?

  workorder workorder? @relation("WorkOrderBookingsCase", fields: [WOID], references: [WOID], onDelete: Restrict)

  // Relations
  createdByUser User @relation("UserCreatedBookings", fields: [CreatedBy], references: [IDUser], onDelete: Restrict)

  bookingDetails BookingDetails[]

  @@index([WOID], map: "fk_address_workorder")
}

model BookingDetails {
  BookingDetailId   Int     @id @default(autoincrement())
  BookingId         Int
  ResourceId        String?
  ResourceAccountId String?

  EngineerId Int? // <-- NEW
  engineer   User? @relation("EngineerCreatedBookings", fields: [EngineerId], references: [IDUser], onDelete: SetNull)

  SubkTechnicianId String?
  Name             String         @db.VarChar(255)
  BookingStatusId  Int?
  Status           BookingStatus? @relation(fields: [BookingStatusId], references: [BookingStatusId])

  // Customer Time
  StartTimeCustomerTime            DateTime?
  EndTimeCustomerTime              DateTime?
  EstimatedArrivalTimeCustomerTime DateTime?
  ActualArrivalTimeCustomerTime    DateTime?

  // User Time
  StartTimeUserTime            DateTime?
  EndTimeUserTime              DateTime?
  DurationInMinutesUserTime    Int?
  EstimatedArrivalTimeUserTime DateTime?
  ActualArrivalTimeUserTime    DateTime?

  ChangedAt DateTime @default(now()) @db.DateTime(0)
  ChangedBy Int

  resource        Resource?        @relation(fields: [ResourceId], references: [ResourceId], onDelete: Restrict, onUpdate: Cascade)
  resourceaccount ResourceAccount? @relation(fields: [ResourceAccountId], references: [ResourceAccountId], onDelete: Restrict, onUpdate: Cascade)
  subkTechnician  SubkTechnician?  @relation(fields: [SubkTechnicianId], references: [SubkTechnicianId], onDelete: Restrict, onUpdate: Cascade)
  booking         Bookings         @relation(fields: [BookingId], references: [BookingId], onDelete: Cascade)

  @@index([EngineerId])
}

model BookingStatus {
  BookingStatusId Int      @id @default(autoincrement())
