model User {
  IDUser       Int       @id @default(autoincrement())
  Email        String?   @unique @db.VarChar(255)
  Username     String    @unique @db.VarChar(100)
  Password     String    @db.VarChar(255)
  Name         String    @db.VarChar(255)
  Role         String    @default("user") @db.VarChar(50)
  ProfilePhoto String?   @db.VarChar(500)
  CreatedAt    DateTime  @default(now())
  UpdatedAt    DateTime  @updatedAt
  Phone        String?   @db.VarChar(20)
  Signature    String?   @db.LongText
  ResourceId   String?   @db.VarChar(255)
  resource     Resource? @relation(fields: [ResourceId], references: [ResourceId])

  caseinformations_created caseinformation[] @relation("UserCreatedCases")
  caseinformations_owned   caseinformation[] @relation("UserOwnedCases")
  bookings_created         Bookings[]        @relation("UserCreatedBookings")
  engineer_booking_detail  BookingDetails[]  @relation("EngineerCreatedBookings")

  workorders_owned     workorder[]     @relation("UserWorkOrders")
  materialorders_owned materialorder[] @relation("UserMaterialOrders")
  ActionLog            ActionLog[]

  // Case notes created by this user
  caseNotes_created casenotes[] @relation("UserCreatedCaseNotes")

  quotationtable     quotationtable[]     @relation("UserQuotationAdmin")
  invoicetable       invoicetable[]       @relation("UserInvoiceAdmin")
  refreshTokens      RefreshToken[]
  down_payment_table down_payment_table[] @relation("UserDPAdmin")
}

model RefreshToken {
  id          Int       @id @default(autoincrement())
