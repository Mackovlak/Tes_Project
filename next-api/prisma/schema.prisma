generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model asset_information {
  AssetID         Int           @id @default(autoincrement())
  SerialNumber    String        @db.VarChar(20)
  ProductNumber   String        @db.VarChar(11)
  SiteAccountID   Int?
  ContactID       Int?
  Warranty_Status String?
  EOW_Date        DateTime?     @db.DateTime(0)
  WarrantyOTCCode OTCCodeTable? @relation(fields: [Warranty_Status], references: [OTCCode])

  site_account        site_account?        @relation(fields: [SiteAccountID], references: [SiteAccountID], onDelete: Restrict, onUpdate: Cascade, map: "asset_information_ibfk_1")
  contact_information contact_information? @relation(fields: [ContactID], references: [ContactID], onDelete: Restrict, onUpdate: Cascade, map: "asset_information_ibfk_2")
  product_information product_information  @relation(fields: [ProductNumber], references: [ProductNumber], onUpdate: Cascade, map: "asset_information_ibfk_3")
  asset_warranty      asset_warranty[]
  caseinformation     caseinformation[]
  servicecatalog      servicecatalog[]

  @@index([ContactID], map: "ContactID")
  @@index([ProductNumber], map: "ProductNumber")
  @@index([SiteAccountID], map: "SiteAccountID")
}

model asset_warranty {
  WarrantyID             Int       @id @default(autoincrement())
  AssetID                Int?
  WarrantyApprovalStatus String?
  PurchaseDate           DateTime?
  WarrantyCardDate       DateTime?
  POPDocument            String?
  WarrantyCard           String?
  PhotoUnit              String?
  EndUserName            String?
  EndUserPhone           String?
  EndUserAddress         String?

  asset_information asset_information? @relation(fields: [AssetID], references: [AssetID], onDelete: Restrict, onUpdate: Cascade, map: "asset_warranty_ibfk_1")

  @@index([AssetID], map: "AssetID")
}

model caseinformation {
  CaseID                                        String               @id
  SiteAccountID                                 Int?
  ContactID                                     Int?
  AssetID                                       Int?
  id_gtc                                        Int?
  id_csr                                        Int?
  CaseID_Manual                                 String?
  CaseID_Manual_Date                            DateTime?            @db.DateTime(0)
  ReferenceCase                                 String?
  CaseSubject                                   String?              @db.VarChar(255)
  CaseType                                      String?              @db.VarChar(100)
  KCI_Flag                                      Boolean?             @default(false)
  IncomingChannel                               String?              @db.VarChar(100)
  CaseStatus                                    CaseStatus           @default(Open)
  VoidReason                                    String?              @db.Text
  CasePriority                                  String?              @db.VarChar(50)
  CustomerSeverity                              String?              @db.VarChar(50)
  CreatedOn                                     DateTime?            @default(now()) @db.DateTime(0)
  CaseClosedDate                                DateTime?            @db.DateTime(0)
  CaseNote                                      Int?
  SymptomCode                                   Int?
  CaseResolution                                String?              @db.Text
  CreatedBy                                     Int?
  Owner                                         Int?
  WorkGround                                    Int?
  IsRerepair                                    Boolean              @default(false)
  RerepairCode                                  String?              @db.VarChar(3)
  repairClassCode                               repairClassCode?     @relation(fields: [RerepairCode], references: [Code], onDelete: Restrict, onUpdate: Cascade)
  site_account                                  site_account?        @relation(fields: [SiteAccountID], references: [SiteAccountID], onDelete: Restrict, onUpdate: Cascade, map: "caseinformation_ibfk_1")
  contact_information                           contact_information? @relation(fields: [ContactID], references: [ContactID], onDelete: Restrict, onUpdate: Cascade, map: "caseinformation_ibfk_2")
  asset_information                             asset_information?   @relation(fields: [AssetID], references: [AssetID], onDelete: Restrict, onUpdate: Cascade, map: "caseinformation_ibfk_3")
  casenotes_caseinformation_CaseNoteTocasenotes casenotes?           @relation("caseinformation_CaseNoteTocasenotes", fields: [CaseNote], references: [NoteID], onDelete: Restrict, onUpdate: Cascade, map: "caseinformation_ibfk_4")
  symptom_codes                                 symptom_codes?       @relation(fields: [SymptomCode], references: [SymptomCodeID], onDelete: Restrict, onUpdate: Cascade, map: "caseinformation_ibfk_5")
  casenotes_casenotes_CaseIDTocaseinformation   casenotes[]          @relation("casenotes_CaseIDTocaseinformation")
  workorder                                     workorder[]
  createdByUser                                 User?                @relation("UserCreatedCases", fields: [CreatedBy], references: [IDUser], onDelete: Restrict, onUpdate: Cascade)
  ownerUser                                     User?                @relation("UserOwnedCases", fields: [Owner], references: [IDUser], onDelete: Restrict, onUpdate: Cascade)
  ServiceCatalogID                              Int?
  StorageLocationStore                          String?              @db.VarChar(50)
  servicecatalog                                servicecatalog?      @relation(fields: [ServiceCatalogID], references: [ServiceCatalogID], onDelete: Restrict, onUpdate: Cascade)
  global_trade_check                            global_trade_check?  @relation(fields: [id_gtc], references: [id_gtc], onDelete: Restrict, onUpdate: Cascade)
  caseresolution                                caseresolution?      @relation(fields: [id_csr], references: [id_csr], onDelete: Restrict, onUpdate: Cascade)
  OTCCode                                       String?              @db.VarChar(5) // Scalar field
  otcCodeTable                                  OTCCodeTable?        @relation(fields: [OTCCode], references: [OTCCode])
  ProblemDescription                            String?              @db.Text
  CaseProductNote                               String?              @db.Text
  ErfDoc                                        String?              @db.Text
  accessory                                     accessory[]
  ActionLog                                     ActionLog[]
  casephotos                                    casephotos[]
  down_payment_table                            down_payment_table[]
  quotationtable                                quotationtable[]
  invoicetable                                  invoicetable[]

  @@index([AssetID], map: "AssetID")
  @@index([CaseNote], map: "CaseNote")
  @@index([ContactID], map: "ContactID")
  @@index([SiteAccountID], map: "SiteAccountID")
  @@index([SymptomCode], map: "SymptomCode")
  @@index([CreatedBy])
  @@index([id_gtc])
  @@index([OTCCode])
  @@index([id_csr])
}

model casephotos {
  id         Int      @id @default(autoincrement())
  CaseID     String
  url        String   @db.VarChar(500) // lokasi file / CDN URL
  filename   String?  @db.VarChar(255)
  size       Int // in bytes
  mimeType   String?  @db.VarChar(100)
  uploadedAt DateTime @default(now()) @db.DateTime(0)

  caseinformation caseinformation @relation(fields: [CaseID], references: [CaseID], onDelete: Cascade)

  @@index([CaseID])
}

model OTCCodeTable {
  OTCCode           String             @id @db.VarChar(5)
  Description       String             @db.VarChar(100)
  WarrantyCondition WarrantyCondition?
  CreatedOn         DateTime?          @default(now()) @db.DateTime(0)

  cases caseinformation[]
  asset asset_information[]
}

model accessory {
  id          Int             @id @default(autoincrement())
  CaseID      String // FK to caseinformation
  Accessories String
  Note        String?
  CT_SNCode   String?
  case        caseinformation @relation(fields: [CaseID], references: [CaseID], onDelete: Cascade)

  @@index([CaseID])
}

model casenotes {
  NoteID     Int     @id @default(autoincrement())
  CaseID     String?
  LogType    String? @db.VarChar(50)
  ActionType String?

  // actionTypeInfo  actiontypecasenotes? @relation("ActionTypeToCasenotes", fields: [ActionTypeID], references: [ActionID])

  Template          String?   @db.VarChar(100)
  VisibleExternally Boolean?  @default(false)
  MinutesSpent      Int?
  Note              String?   @db.Text
  CreatedOn         DateTime? @default(now()) @db.DateTime(0)
  CreatedBy         Int?

  // Relation to User who created the note
  createdByUser User? @relation("UserCreatedCaseNotes", fields: [CreatedBy], references: [IDUser])

  caseinformation_caseinformation_CaseNoteTocasenotes caseinformation[] @relation("caseinformation_CaseNoteTocasenotes")
  caseinformation_casenotes_CaseIDTocaseinformation   caseinformation?  @relation("casenotes_CaseIDTocaseinformation", fields: [CaseID], references: [CaseID], onDelete: Restrict, onUpdate: Cascade, map: "casenotes_ibfk_1")

  @@index([CaseID], map: "CaseID")
  @@index([CreatedBy])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  model     String   @db.VarChar(100)
  operation String   @db.VarChar(10) // create, update, delete
  userId    Int?
  dataOld   Json?
  dataNew   Json?
  timestamp DateTime @default(now())
}

model ActionLog {
  id             Int      @id @default(autoincrement())
  CaseId         String
  ReferenceId    String?
  model          String   @db.VarChar(100)
  dataOld        String   @db.VarChar(50)
  dataNew        String   @db.VarChar(50)
  changedBy      Int?
  ChangeAt       DateTime @default(now())
  logDescription String?  @db.Text

  changedByUser      User?            @relation(fields: [changedBy], references: [IDUser]) // Define the relation
  CaseID_toActionLog caseinformation? @relation(fields: [CaseId], references: [CaseID])
}

model contact_information {
  ContactID         Int     @id @default(autoincrement())
  SiteAccountID     Int?
  Salutation        String? @db.VarChar(20)
  FirstName         String  @db.VarChar(100)
  LastName          String  @db.VarChar(100)
  Email             String? @db.VarChar(255)
  PreferredLanguage String? @db.VarChar(50)
  Phone             String? @db.VarChar(50)
  Mobile            String? @db.VarChar(50)
  WorkPhone         String? @db.VarChar(50)
  WorkExtension     String? @db.VarChar(10)
  OtherPhone        String? @db.VarChar(50)
  OtherExtension    String? @db.VarChar(10)
  Fax               String? @db.VarChar(50)
  AddressLine1      String? @db.VarChar(255)
  AddressLine2      String? @db.VarChar(255)
  City              String? @db.VarChar(100)
  StateProvince     String? @db.VarChar(100)
  Country           String? @db.VarChar(100)
  ZipPostalCode     String? @db.VarChar(20)
  NIK               String? @db.VarChar(25)

  PIC_Name          String?             @db.VarChar(100)
  PIC_Email         String?             @db.VarChar(100)
  PIC_Phone         String?             @db.VarChar(100)
  asset_information asset_information[]
  caseinformation   caseinformation[]
  site_account      site_account?       @relation(fields: [SiteAccountID], references: [SiteAccountID], onDelete: Restrict, onUpdate: Cascade, map: "contact_information_ibfk_1")

  @@index([SiteAccountID], map: "SiteAccountID")
}

model global_trade_check {
  id_gtc              Int    @id @default(autoincrement())
  global_trade_status String @db.VarChar(30)
  embargoed_country   String @db.VarChar(30)
  gt_override_reason  String @db.VarChar(30)
  gt_details          String @db.VarChar(50)
  screening_id        String @db.VarChar(25)
  gt_active_listening String @db.VarChar(30)
  gt_al_comments      String @db.VarChar(50)

  caseinformation caseinformation[]
}

model down_payment_table {
  ID_DP_table Int    @id @default(autoincrement())
  //CUSTOM KEY
  DPInvoiceNo String @unique

  //FK Key
  CaseID          String?
  caseinformation caseinformation? @relation(fields: [CaseID], references: [CaseID], onDelete: Restrict)

  DPAmount    Decimal  @default(0) @db.Decimal(12, 2)
  DPDate      DateTime @default(now()) @db.DateTime(0)
  PaymentDate DateTime @default(now()) @db.DateTime(0)

  PaymentType String? @db.VarChar(20)
  DPNote      String? @db.Text

  //SYSTEM 
  CreatedBy     Int
  CreatedByUser User @relation("UserDPAdmin", fields: [CreatedBy], references: [IDUser], onDelete: Restrict)

  CreatedOn DateTime @default(now()) @db.DateTime(0)
  ChangedOn DateTime @default(now()) @db.DateTime(0)
}

model invoicetable {
  InvoiceNo         String   @id
  INV_No            Int?     @db.Int
  CaseID            String?
  QuotationNo       String?
  AmountReceive     Decimal  @default(0) @db.Decimal(12, 2) //AWKOAKOWKAOWKOAWK LUPA NAMBAHIN LIMIT DECIMAL AJG
  AmountDiff        Decimal  @default(0) @db.Decimal(12, 2)
  AmountDiffReason  String?  @db.Text
  PaymentType       String?  @db.VarChar(20)
  AmountReceiveDate DateTime @default(now()) @db.DateTime(0)
  AmountReceiveNote String?  @db.Text

  SendWa      Boolean @default(false)
  SendEmail   Boolean @default(false)
  SendInvoice Boolean @default(false)
  SendERF     Boolean @default(false)

  CreatedBy       Int
  CreatedByUser   User             @relation("UserInvoiceAdmin", fields: [CreatedBy], references: [IDUser], onDelete: Restrict)
  caseinformation caseinformation? @relation(fields: [CaseID], references: [CaseID], onDelete: Restrict)
  quotation       quotationtable?  @relation(fields: [QuotationNo], references: [QuotationNo], onDelete: Restrict)

  CreatedOn DateTime @default(now()) @db.DateTime(0)
  ChangedOn DateTime @default(now()) @db.DateTime(0)
}

model quotationtable {
  QuotationNo           String             @id
  Quote_No_Search       Int?               @db.Int
  QuotationType         QuotationType      @default(Simple)
  Currency              String             @default("IDR") @db.VarChar(8)
  LaborFee              Int                @default(0)
  VatValue              Int?
  Subtotal              Decimal?           @db.Decimal(10, 2) // Total sebelum PPN
  VATAmount             Decimal?           @db.Decimal(10, 2) // Nilai PPN
  QuotationDate         DateTime           @default(now()) @db.DateTime(0)
  QuotationApprovedDate DateTime?          @db.DateTime(0)
  UserAssign            Int
  User                  User               @relation("UserQuotationAdmin", fields: [UserAssign], references: [IDUser], onDelete: Restrict)
  QuotationNote         String?            @db.Text
  SendWa                Boolean            @default(false)
  SendEmail             Boolean            @default(false)
  QuoteDecision         QuotationDecision?

  CaseID          String?
  caseinformation caseinformation? @relation(fields: [CaseID], references: [CaseID], onDelete: Restrict)

  GrandTotal         Decimal?             @db.Decimal(10, 2) // Total akhir
  quotation_lineitem quotation_lineitem[]
  invoicetable       invoicetable[]
}

model quotation_lineitem {
  id          Int    @id @default(autoincrement())
  QuotationNo String
  LineItemID  Int

  quotation quotationtable         @relation(fields: [QuotationNo], references: [QuotationNo], onDelete: Cascade)
  lineItem  materialorderlineitems @relation(fields: [LineItemID], references: [LineItemID], onDelete: Cascade)

  Price    Decimal @db.Decimal(10, 2) // bisa simpan harga di waktu itu
  Approved Boolean @default(false) // untuk "Part Approved" Yes/No

  @@unique([QuotationNo, LineItemID])
}

model materialorder {
  MOID             String              @id
  MO_Number        Int?                @db.Int
  WOID             String?
  OrderNumber      String?             @db.VarChar(100) //Wait, why this is here? wtf is this even about? lol
  OrderStatus      MaterialOrderStatus @default(New)
  OrderType        String?             @db.VarChar(50)
  CreatedOn        DateTime?           @default(now()) @db.DateTime(0)
  SalesOrderNumber String?             @db.VarChar(100)
  RMANumber        String?             @db.VarChar(100)
  RMAStatus        RMAStatus?

  AWB_InCode  String? @db.VarChar(100)
  AWB_OutCode String? @db.VarChar(100)

  ReadyForClosureDate        DateTime?         @db.DateTime(0) // Part out Hand CE Date
  ShippingPriority           ShippingPriority? @default(MEDIUM)
  CustomerInducedDamage      Boolean?          @default(false)
  AccidentalDamageProtection Boolean?          @default(false)
  DefectiveMediaRetention    Boolean?          @default(false)

  DeliveryRequestedDate   DateTime?       @db.DateTime(0) //ETA Delivery Required Date (Customer Time)
  CollectionRequestedDate DateTime?       @db.DateTime(0) //Part on Hand CE Date
  PromoCode               String?         @db.VarChar(50)
  NotificationNumber      String?         @db.VarChar(100)
  ParentMOID              String?         @db.VarChar(13)
  IsBCPOrder              Boolean?        @default(false)
  MaterialOrderType       String?         @db.VarChar(50)
  EOTOrderNumber          String?         @db.VarChar(50)
  ResourceId              String?         @db.VarChar(255)
  parentMO                materialorder?  @relation("ParentMaterialOrder", fields: [ParentMOID], references: [MOID], onDelete: Restrict)
  childMOs                materialorder[] @relation("ParentMaterialOrder")

  OwnerID Int?
  owner   User? @relation("UserMaterialOrders", fields: [OwnerID], references: [IDUser], onDelete: Restrict)

  workorder              workorder?               @relation(fields: [WOID], references: [WOID], onDelete: Restrict, map: "materialorder_ibfk_1")
  materialorderlineitems materialorderlineitems[]

  @@index([WOID], map: "WOID")
  @@index([ResourceId], map: "ResourceId")
  @@index([OwnerID])
}

model materialorderlineitems {
  LineItemID   Int                         @id @default(autoincrement())
  MOID         String?
  LineNumber   Int?
  PartNumber   String?                     @db.VarChar(100)
  Description  String?                     @db.Text
  ATPStatus    String?                     @db.VarChar(50)
  Quantity     Int?
  QuantityUsed Boolean                     @default(true)
  Status       MaterialOrderLineItemStatus @default(New)
  Price        Decimal?                    @db.Decimal(10, 2)

  // Revisi Tambahan
  FunctionalEquivalence   String?                    @db.VarChar(100)
  MediaHandlingPart       String?                    @db.VarChar(100)
  PickPackInstructions    String?                    @db.Text
  CollectionInstructions  CollectionInstructionType? @default(None)
  CustomerResponse        String?                    @db.Text
  RejectedReason          String?                    @db.Text
  OtherReason             String?                    @db.Text
  PartAuthorizationReason String?                    @db.Text
  PartAuthorizationDetail String?                    @db.Text
  OriginalPartNumber      String?                    @db.VarChar(100)
  OfferedPartNumber       String?                    @db.VarChar(100)
  OfferedPartDescription  String?                    @db.Text
  MainComponent           String?                    @db.VarChar(100)

  SerialNumber           String? @db.VarChar(100)
  RemovedPartNumber      String? @db.VarChar(100) //RETURN CT KEY (BAD CT)
  RemovedSerialNumber    String? @db.VarChar(100) //NEW CT KEY (NEW CT)
  RemovedPartDescription String? @db.Text

  UEFICode UEFICode?
  UEFI_NO  String?   @db.VarChar(100)

  PartReturnStatusId Int?
  partReturnStatus   PartReturnStatus? @relation(fields: [PartReturnStatusId], references: [ReturnStatusId])
  DOAReason          String?           @db.VarChar(100)
  PhotoPartUnit      String?           @db.Text()
  GoodReturnReason   GoodReturnReason?

  // Foreign key ke Failure
  FailureId Int?
  failure   Failure? @relation(fields: [FailureId], references: [FailureId], onDelete: SetNull)

  materialorder        materialorder?        @relation(fields: [MOID], references: [MOID], onDelete: Restrict, map: "materialorderlineitems_ibfk_1")
  servicecatalog_parts servicecatalog_parts? @relation(fields: [PartNumber], references: [PartNumber], onDelete: Restrict, map: "materialorderlineitems_ibfk_2")

  CTValidation       Boolean?
  quotation_lineitem quotation_lineitem[]

  @@index([MOID], map: "MOID")
  @@index([PartNumber], map: "PartNumber")
}

model Failure {
  FailureId   Int     @id @default(autoincrement())
  Name        String
  Description String?

  materialorderlineitems materialorderlineitems[]
}

model PartReturnStatus {
  ReturnStatusId         Int                      @id @default(autoincrement())
  StatusName             String
  StatusQuantityType     Boolean                  @default(true)
  DOA                    Boolean                  @default(false)
  materialorderlineitems materialorderlineitems[]
}

model product_information {
  ProductNumber       String              @id @db.VarChar(11)
  ProductLine         String              @db.VarChar(3)
  ProductName         String              @db.VarChar(255)
  ProductTypeID       Int
  HWPC                String?             @db.VarChar(50)
  end_of_sales_date   DateTime?           @db.Date
  end_of_support_date DateTime?           @db.Date
  vendor              String?             @db.VarChar(50)
  asset_information   asset_information[]
  product_type        product_type        @relation(fields: [ProductTypeID], references: [ProductTypeID], onUpdate: Cascade, onDelete: Restrict, map: "product_information_ibfk_1")

  @@index([ProductTypeID], map: "ProductTypeID")
}

model product_type {
  ProductTypeID       Int                        @id @default(autoincrement())
  ProductType         String                     @db.VarChar(50)
  ProductTower        product_type_ProductTower?
  ProductGroup        product_type_ProductGroup?
  product_information product_information[]
}

model servicecatalog {
  ServiceCatalogID         Int                        @id @default(autoincrement())
  AssetID                  Int
  Service_offerID          String                     @db.VarChar(8)
  PartNumber               String?                    @db.VarChar(100)
  WarrantyStatus           String?                    @db.VarChar(50)
  Currency                 String?                    @db.VarChar(10)
  Price                    Decimal?                   @db.Decimal(10, 2)
  Tax                      Decimal?                   @db.Decimal(10, 2)
  Total                    Decimal?                   @db.Decimal(10, 2)
  asset_information        asset_information          @relation(fields: [AssetID], references: [AssetID], map: "servicecatalog_ibfk_1")
  servicecatalog_parts     servicecatalog_parts?      @relation(fields: [PartNumber], references: [PartNumber], onDelete: Restrict, map: "servicecatalog_ibfk_2")
  warranty_services        warranty_services          @relation(fields: [Service_offerID], references: [Service_offerID], map: "servicecatalog_ibfk_3")
  caseinformation          caseinformation[]
  serviceCatalogManytoMany ServiceCatalogManytoMany[]
  workorder                workorder?

  @@index([AssetID], map: "AssetID")
  @@index([PartNumber], map: "PartNumber")
  @@index([Service_offerID], map: "Service_offerID")
}

model servicecatalog_parts {
  PartNumber          String                     @id @db.VarChar(100)
  VendorPartNumber    String?                    @unique @db.VarChar(100)
  ProductType         product_type_ProductTower?
  Keyword             String?                    @db.VarChar(100)
  PartDescription     String?                    @db.Text
  Orderability        Boolean?
  RestrictionReason   String?                    @db.Text
  CSR_Flag            Boolean?                   @default(false)
  ROHS_Flag           Boolean?                   @default(false)
  Returnable_Flag     Boolean?                   @default(false)
  HardRoll_Flag       Boolean?                   @default(false)
  DangerousGoods_Flag Boolean?                   @default(false)
  LithiumBattery_Flag Boolean?                   @default(false)
  Oversize_Flag       Boolean?                   @default(false)
  Heavy_Flag          Boolean?                   @default(false)
  //HP ORIGINAL PRICE
  Price               Decimal                    @default(0.00) @db.Decimal(10, 2)
  //Exchange Rate
  FreightPrice        Decimal                    @default(0.00) @db.Decimal(10, 2)
  Tax                 Decimal                    @default(0.00) @db.Decimal(10, 2)
  Total               Decimal                    @default(0.00) @db.Decimal(10, 2)
  Shipping_Fee        Decimal                    @db.Decimal(10, 2)

  PartLaborToPatner Decimal @default(0.00) @db.Decimal(10, 2)
  ODMOriginalPrice  Decimal @default(0.00) @db.Decimal(10, 2)
  ODMPatnerPrice    Decimal @default(0.00) @db.Decimal(10, 2)
  ODMUserPrice      Decimal @default(0.00) @db.Decimal(10, 2)

  materialorderlineitems   materialorderlineitems[]
  servicecatalog           servicecatalog[]
  serviceCatalogManytoMany ServiceCatalogManytoMany[]
}

model ServiceCatalogManytoMany {
  id               Int    @id @default(autoincrement())
  ServiceCatalogID Int
  PartNumber       String

  servicecatalog servicecatalog       @relation(fields: [ServiceCatalogID], references: [ServiceCatalogID])
  part           servicecatalog_parts @relation(fields: [PartNumber], references: [PartNumber])

  @@unique([ServiceCatalogID, PartNumber])
}

model site_account {
  SiteAccountID       Int                   @id @default(autoincrement())
  Company             String                @db.VarChar(255)
  Email               String?               @db.VarChar(255)
  PrimaryPhone        String?               @db.VarChar(50)
  WhatsappNo          String?               @db.VarChar(50)
  AddressLine1        String                @db.VarChar(255)
  AddressLine2        String?               @db.VarChar(255)
  City                String                @db.VarChar(100)
  StateProvince       String?               @db.VarChar(100)
  Country             String                @db.VarChar(100)
  ZipPostalCode       String                @db.VarChar(20)
  NPWP                String?               @db.VarChar(25)
  asset_information   asset_information[]
  caseinformation     caseinformation[]
  contact_information contact_information[]
}

model symptom_codes {
  SymptomCodeID   Int               @id @default(autoincrement())
  SymptomCode     String            @db.VarChar(50)
  TopCategory     String            @db.VarChar(50)
  SubCategory     String            @db.VarChar(50)
  QualityCodes    String?           @db.VarChar(50)
  CreatedOn       DateTime          @default(now()) @db.Timestamp(0)
  caseinformation caseinformation[]
}

model test_table_without_migration {
  id                  Int     @id @default(autoincrement())
  name                String  @db.VarChar(12)
  testI12november2025 String? @db.VarChar(12)

  @@map("test-table-without-migration")
}

model test_table {
  MOID                Int       @id @default(autoincrement())
  WOID                Int?
  OrderNumber         String?   @db.VarChar(100)
  OrderStatus         String?   @db.VarChar(50)
  OrderType           String?   @db.VarChar(50)
  CreatedOn           DateTime? @default(now()) @db.DateTime(0)
  SalesOrderNumber    String?   @db.VarChar(100)
  RMANumber           String?   @db.VarChar(100)
  ReadyForClosureDate DateTime? @db.DateTime(0)
  Owner               String?   @db.VarChar(100)

